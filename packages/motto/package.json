{
  "name": "@weareikko/motto",
  "version": "0.1.2",
  "description": "Skill-eval tool: validate a Claude Code Agent Skill against its own description contract — trigger fidelity, claim fidelity, and token cost — across harnesses and models.",
  "keywords": [
    "claude",
    "claude-code",
    "skills",
    "skill",
    "eval",
    "evals",
    "llm"
  ],
  "homepage": "https://github.com/weareikko/motto/tree/main/packages/motto#readme",
  "bugs": {
    "url": "https://github.com/weareikko/motto/issues"
  },
  "license": "MIT",
  "author": "weareikko",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/weareikko/motto.git",
    "directory": "packages/motto"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "motto": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "motto": "tsx src/cli.ts",
    "evals": "vitest run --config vite.eval.config.ts",
    "evals:list": "tsx src/list-harnesses.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@earendil-works/pi-agent-core": "^0.80.6",
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "citty": "^0.2.2",
    "dotenv": "^17.4.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
