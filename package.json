{
  "name": "@ikko-dev/eslint-plugin-skill",
  "version": "0.1.0",
  "description": "ESLint plugin that lints Claude Code Agent Skills (SKILL.md) for quality — portable to oxlint.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "oxlint",
    "claude",
    "claude-code",
    "skills",
    "skill",
    "markdown"
  ],
  "homepage": "https://github.com/ikko-dev/eslint-plugin-skill#readme",
  "bugs": {
    "url": "https://github.com/ikko-dev/eslint-plugin-skill/issues"
  },
  "license": "MIT",
  "author": "ikko-dev",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ikko-dev/eslint-plugin-skill.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dedup": {
      "types": "./dist/dedup/index.d.ts",
      "default": "./dist/dedup/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "skill-check-refs": "./dist/dedup/cli.js"
  },
  "files": [
    "dist",
    "configs",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && chmod +x dist/dedup/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:evals": "tsc -p tsconfig.evals.json",
    "check": "npm run typecheck && npm run typecheck:tests && npm run typecheck:evals && npm test",
    "evals": "vitest run --config vite.eval.config.ts",
    "evals:list": "tsx evals/list-harnesses.ts",
    "prepublishOnly": "npm run check && npm run build && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@eslint/markdown": "^8.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.1-rc",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "vitest-evals": "^0.14.0"
  }
}
