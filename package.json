{
  "name": "@ikko-dev/eslint-plugin-skill",
  "version": "0.1.0",
  "description": "ESLint plugin that lints Claude Code Agent Skills (SKILL.md) for quality — portable to oxlint.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "oxlint",
    "claude",
    "claude-code",
    "skills",
    "skill",
    "markdown"
  ],
  "homepage": "https://github.com/ikko-dev/eslint-plugin-skill#readme",
  "bugs": {
    "url": "https://github.com/ikko-dev/eslint-plugin-skill/issues"
  },
  "license": "MIT",
  "author": "ikko-dev",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ikko-dev/eslint-plugin-skill.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "main": "./src/index.js",
  "files": [
    "src",
    "configs",
    "docs",
    "README.md",
    "PORTABILITY.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint \"**/SKILL.md\"",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@eslint/markdown": "^7.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  }
}
