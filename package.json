{
  "name": "motto",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling for authoring high-quality Claude Code Agent Skills: the motto skill-eval tool + the eslint-plugin-skill hygiene linter.",
  "type": "module",
  "license": "MIT",
  "author": "weareikko",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/weareikko/motto.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @weareikko/eslint-plugin-skill -w @weareikko/motto",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.1-rc",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "vitest-evals": "^0.14.0"
  }
}
